# AI review settings. Copy this file to .env and fill it in:  Copy-Item .env.example .env
# NEVER commit .env. Never paste your key in the terminal or in a chat.

# none, anthropic or openai_compatible
VEDIX_AI_PROVIDER=none

# A model name from your provider's list. No default on purpose.
VEDIX_AI_MODEL=

VEDIX_AI_API_KEY=

# Optional. Defaults: https://api.anthropic.com  or  https://api.openai.com/v1
# For Groq, OpenRouter, Together or Cerebras, copy the base URL from their docs.
# A local model server can use http://localhost:<port>/v1 and needs no key.
VEDIX_AI_BASE_URL=


# ---- API server (Phase 1b) ----
# Browser origins allowed to call the API, separated by commas.
VEDIX_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true = run the AI review on every request when a provider is set.
# The VEDIX frontend has no switch for it yet. Only use true on your own computer.
VEDIX_API_AI_DEFAULT=false
# on or off. The page with the API documentation at /docs
VEDIX_API_DOCS=on
VEDIX_MAX_ACTIVE_JOBS=4

# Fetch public GitHub repositories (ZIP download of the default branch). on or off.
VEDIX_API_REPOS=on
VEDIX_MAX_ACTIVE_FETCHES=2